# Базовый URL API. Пусто = тот же хост (эндпоинты начинаются с /api/v1).
# В dev удобно оставить пустым и пользоваться прокси из vite.config.ts.
VITE_API_URL=

# Dev-мок Telegram initData. Подставляется как заголовок X-TG-Init-Data,
# когда приложение открыто в обычном браузере (window.Telegram.WebApp.initData пустой).
# Возьми валидную строку initData из реального запуска бота, чтобы бэкенд принял подпись.
VITE_DEV_INIT_DATA=

# Ссылка на бота для экрана «открыто вне Telegram».
VITE_BOT_URL=https://t.me/your_bot
